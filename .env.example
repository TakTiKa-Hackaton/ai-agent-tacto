# Arena connection
ARENA_URL=https://arena.tacto.ai
ARENA_API_KEY=

# Bundled research data; keep a Sunday release alongside it when available.
ARENA_DATA=data
# ARENA_RELEASE=data/release-sunday

# Optional OpenAI-compatible email drafting. Decisions and offer terms stay deterministic.
# Leave LLM_MODEL empty to use the built-in email writer.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional bounded specialist, rejection-risk, and decision-boss council.
# Keep disabled until a compatible model key and a practice run are available.
LLM_COUNCIL_ENABLED=false
LLM_COUNCIL_MODEL=gpt-6-luna
LLM_API_BUDGET_USD=2
